# Copy this to .env and fill in values before running the app.
# NEVER commit .env to version control.

# Django
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=postgres://judiciary:judiciary@localhost:5432/judiciary_db

# Redis
REDIS_URL=redis://localhost:6379/0

# File Storage (set USE_S3=True for S3-compatible storage)
USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=judiciary-documents
# AWS_S3_ENDPOINT_URL=http://localhost:9000  # MinIO in dev

# Email (SendGrid)
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=noreply@judiciary.gm

# SMS (Twilio — swap for Gamcel/Africell gateway in prod)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MUSU Payment Gateway
MUSU_API_BASE_URL=https://api.musu.gm/v1
MUSU_MERCHANT_ID=
MUSU_API_KEY=
MUSU_WEBHOOK_SECRET=
